DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# Optional. Cloudflare TURN key (Dashboard > Realtime > TURN). When both are
# set, calls are relayed and neither person sees the other's IP. Without them,
# calls connect directly via STUN.
TURN_KEY_ID=""
TURN_KEY_API_TOKEN=""

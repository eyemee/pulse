// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id       String   @id // client-generated session uuid
  lat      Float // ALREADY privacy-offset coords (raw is never stored)
  lng      Float
  busy     Boolean  @default(false) // true while in an active connection
  // Who this user is dealing with: the person they requested (busy=false)
  // or their active partner (busy=true). Lets the server reject signals
  // that don't match a real connection.
  peerId   String?
  lastSeen DateTime

  @@index([lastSeen])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}

model RateLimit {
  // Fixed-window counters for abuse limits, e.g. "req:<id>" or "join:<ip>".
  // Kept in Postgres so limits hold across serverless instances. Old rows
  // are swept by /api/poll.
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

model Block {
  // "blocker doesn't want to hear from blocked." Enforced both ways: neither
  // sees the other on the map and requests between them are refused. Rows
  // only live as long as both sessions do (swept by /api/poll and /api/leave),
  // since public ids are per-session anyway.
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}
